# ─── Required ───────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
PROVIDER_TOKEN=your_payment_provider_token_here

# ─── Admin ──────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# ─── Packages ───────────────────────────────────────────────────────────────────
# JSON array of star packages. Each item must have "stars" (int) and "price_rub" (int).
PACKAGES_JSON=[{"stars":100,"price_rub":199},{"stars":250,"price_rub":449},{"stars":500,"price_rub":849},{"stars":1000,"price_rub":1599}]

# ─── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no additional setup required):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# PostgreSQL (uncomment and fill in to use Postgres instead):
# DATABASE_URL=postgresql+asyncpg://botuser:botpass@postgres:5432/tgsta

# ─── Postgres container (only needed when using docker compose --profile postgres) ─
# POSTGRES_USER=botuser
# POSTGRES_PASSWORD=botpass
# POSTGRES_DB=tgsta

# ─── Settings ───────────────────────────────────────────────────────────────────
# SLA text shown to user after successful payment
SLA_TEXT=Заказ будет исполнен в течение 5–30 минут (в рабочее время).

# Number of orders shown in "My Orders"
ORDERS_LIMIT=10
