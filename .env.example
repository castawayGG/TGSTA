# ── Bot ───────────────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── Payments ──────────────────────────────────────────────────────────────────
# Provider token from @BotFather (e.g. YooKassa / CloudPayments / test token)
PROVIDER_TOKEN=YOUR_PROVIDER_TOKEN_HERE

# ISO 4217 currency code. For Telegram Payments in RUB use "RUB".
CURRENCY=RUB

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that get admin access
ADMIN_IDS=123456789,987654321

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for SQLite (./data/app.db) or set a PostgreSQL DSN:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tgsta
DATABASE_URL=

# ── Packages ──────────────────────────────────────────────────────────────────
# JSON array: each object must have "stars" (int) and "price" (int, kopecks for RUB).
# price is in the *smallest currency unit* (kopecks for RUB).
# Example: 100 stars = 199 rubles = 19900 kopecks.
PACKAGES_JSON=[{"stars":100,"price":19900,"label":"100 ⭐"},{"stars":250,"price":44900,"label":"250 ⭐"},{"stars":500,"price":84900,"label":"500 ⭐"},{"stars":1000,"price":159900,"label":"1000 ⭐"}]

# ── UX ────────────────────────────────────────────────────────────────────────
# Message shown to user about execution time
ORDER_SLA_TEXT=Исполнение вручную — обычно в течение 15–60 минут.

# Support contact shown in /help
SUPPORT_CONTACT=@your_support_username

# ── Terms ─────────────────────────────────────────────────────────────────────
# Either provide a URL or inline text (TERMS_TEXT takes priority over TERMS_URL)
TERMS_URL=https://example.com/terms
TERMS_TEXT=
